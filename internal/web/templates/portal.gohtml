<!doctype html>
<html lang="{{.Lang}}" dir="{{.Dir}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#0064E0">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="useg">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<title>{{T .Lang "portal.title"}}</title>
<link rel="manifest" href="/assets/manifest.json">
<link rel="icon" href="/assets/icon-192.png" type="image/png">
<link rel="apple-touch-icon" href="/assets/icon-180.png">
<link rel="stylesheet" href="/assets/app.css?v=4">
</head>
<body class="page">
<main class="page-inner portal">

  <header class="portal-bar">
    <span class="portal-brand">useg</span>
    {{if .Known}}
    <span class="status-pill{{if .Blocked}} is-off{{end}}"><span class="status-dot" aria-hidden="true"></span>{{if .Blocked}}{{T .Lang "portal.offline"}}{{else}}{{T .Lang "portal.online"}}{{end}}</span>
    {{end}}
  </header>

  <section class="portal-hello">
    <h1>{{T .Lang "portal.hello"}}{{if .PersonName}}، {{.PersonName}}{{end}}</h1>
    {{if and .Known (not .PersonName)}}<p class="portal-sub">{{.DeviceName}}</p>{{end}}
  </section>

  {{if .Notice}}<div class="alert alert-success portal-alert">{{.Notice}}</div>{{end}}

  {{if .Blocked}}
  <div class="alert alert-danger portal-alert">
    <strong>{{T .Lang "portal.blocked"}}</strong>
    <p>{{.Reason}}</p>
    <p class="small">{{T .Lang "portal.blocked_hint"}}</p>
  </div>
  {{end}}

  {{if .Known}}
  <section class="quota-card">
    <p class="quota-label">{{T .Lang "portal.remaining"}}</p>
    {{if .Unlimited}}
      <p class="quota-big">{{T .Lang "portal.unlimited"}}</p>
      <p class="quota-sub">{{T .Lang "portal.used"}}: {{bytes .Used .Lang}}</p>
    {{else}}
      <p class="quota-big num">{{bytes .Remaining .Lang}}</p>
      <p class="quota-sub">{{T .Lang "portal.of"}} {{bytes .Cap .Lang}}</p>
      <div class="progress progress-lg" role="progressbar" aria-valuenow="{{.Pct}}" aria-valuemin="0" aria-valuemax="100"><div class="progress-fill{{if .Over}} is-danger{{end}}" style="width: {{.Pct}}%"></div></div>
      <div class="quota-meta">
        <span>{{T .Lang "portal.used"}} {{bytes .Used .Lang}}</span>
        {{if .DaysLeft}}<span>{{digits .DaysLeft .Lang}} {{T .Lang "portal.days_left"}}</span>{{end}}
      </div>
    {{end}}
  </section>

  <section class="portal-section">
    <h2 class="portal-h2">{{T .Lang "portal.devices"}}</h2>
    <ul class="dev-list">
      {{range .Devices}}
      <li class="dev">
        <span class="dev-icon" aria-hidden="true">
          <svg viewBox="0 0 16 16" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.2"><rect x="4.5" y="1.5" width="7" height="13" rx="2"/><path d="M7 12.2h2" stroke-linecap="round"/></svg>
        </span>
        <div class="dev-main">
          <span class="dev-name">{{.Name}}</span>
          {{if .Current}}<span class="badge badge-info">{{T $.Lang "portal.this_device"}}</span>{{end}}
          {{if .Blocked}}<span class="badge badge-danger">{{T $.Lang "portal.blocked_short"}}</span>{{end}}
        </div>
        <span class="dev-used num">{{bytes .Used $.Lang}}</span>
      </li>
      {{end}}
    </ul>
  </section>
  {{if .PersonName}}
  <section class="portal-section">
    <div class="portal-head-row">
      <h2 class="portal-h2">{{T .Lang "portal.daily_title"}}</h2>
      <button class="btn btn-sm btn-secondary" type="button" popovertarget="daily-limit-pop">{{T .Lang "portal.daily_set"}}</button>
    </div>
    <p class="quota-sub">{{T .Lang "portal.today"}}: {{bytes .DailyUsed .Lang}}{{if .HasDaily}} / {{bytes .DailyCap .Lang}}{{else}} · {{T .Lang "portal.daily_no_limit"}}{{end}}</p>
    {{if .DailyHistory}}
    <ul class="dev-list">
      {{range .DailyHistory}}
      <li class="dev">
        <span class="dev-main"><span class="dev-name">{{.Label}}{{if .Today}}<span class="badge badge-info">{{T $.Lang "portal.today"}}</span>{{end}}</span></span>
        <span class="dev-used num">{{bytes .Bytes $.Lang}}</span>
      </li>
      {{end}}
    </ul>
    {{end}}
    <div id="daily-limit-pop" popover class="portal-pop">
      <form method="post" action="/daily-limit" class="stack">
        <label class="field">
          <span class="field-label">{{T .Lang "portal.daily_limit_label"}}</span>
          <input class="input" type="number" inputmode="decimal" step="any" min="0" name="gb" value="{{.DailyLimitGB}}" placeholder="{{T .Lang "portal.daily_no_limit"}}">
        </label>
        <button class="btn btn-sm btn-primary">{{T .Lang "portal.daily_save"}}</button>
      </form>
    </div>
  </section>
  {{end}}
  {{if .People}}
  <details class="portal-section">
    <summary class="portal-h2">{{T .Lang "nav.persons"}}</summary>
    <ul class="dev-list">
      {{range .People}}
      <li class="dev">
        <span class="dev-icon" aria-hidden="true">
          <svg viewBox="0 0 16 16" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.2"><circle cx="8" cy="5.5" r="2.6"/><path d="M3.2 13.5a4.8 4.8 0 0 1 9.6 0" stroke-linecap="round"/></svg>
        </span>
        <div class="dev-main">
          <span class="dev-name">{{.Name}}</span>
          {{if .You}}<span class="badge badge-info">{{T $.Lang "portal.you"}}</span>{{end}}
        </div>
        {{if and $.Transferable (not .You)}}
        <a class="btn btn-sm btn-secondary btn-icon" href="/transfer?to={{.ID}}" aria-label="{{T $.Lang "portal.transfer"}} {{.Name}}" title="{{T $.Lang "portal.transfer"}} {{.Name}}">
          <svg viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 5.5h8.5M9.5 3.5l2 2-2 2M13 10.5H4.5M6.5 8.5l-2 2 2 2"/></svg>
        </a>
        {{end}}
      </li>
      {{end}}
    </ul>
  </details>
  {{end}}
  {{else}}
  <section class="card"><p class="m-0">{{T .Lang "portal.unknown"}}</p></section>
  {{end}}

  <footer class="page-foot small">
    <p>{{T .Lang "portal.period_ends"}}: {{.PeriodEnd}}</p>
  </footer>

</main>
</body>
</html>
