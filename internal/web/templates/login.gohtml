<!doctype html>
<html lang="{{.Lang}}" dir="{{.Dir}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>useg admin</title>
<link rel="stylesheet" href="/assets/app.css?v=2">
</head>
<body class="page page-center">
<main class="auth">
  <h1 class="auth-title">useg admin</h1>
  {{if .Error}}<div class="alert alert-danger">{{.Error}}</div>{{end}}
  <form method="post" action="/admin/login" class="card stack">
    <div class="field">
      <label class="field-label" for="password">{{T .Lang "login.password"}}</label>
      <input class="input" id="password" type="password" name="password" autofocus>
    </div>
    <button class="btn btn-primary btn-block">{{T .Lang "login.signin"}}</button>
  </form>
  <p class="muted small" style="margin-top:12px"><a href="?lang=fa">فارسی</a> · <a href="?lang=en">EN</a></p>
</main>
</body>
</html>
